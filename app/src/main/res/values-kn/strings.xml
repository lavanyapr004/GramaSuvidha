    <string name="welcome_subtitle">ಗ್ರಾಮೀಣ ಅಭಿವೃದ್ಧಿ ಪಾರದರ್ಶಕತೆಗಾಗಿ ನಿಮ್ಮ ಪೋರ್ಟಲ್</string>
    <string name="vision_title">ನಮ್ಮ ಯೋಜನೆಯ ದೃಷ್ಟಿಕೋನ</string>
    <string name="problem_statement_title">ಸಮಸ್ಯೆ</string>
    <string name="problem_statement_text">ಗ್ರಾಮೀಣ ಮೂಲಸೌಕರ್ಯದಲ್ಲಿ ಪಾರದರ್ಶಕತೆಯ ಕೊರತೆಯಿದೆ. ಸ್ಥಳೀಯ ಕಾಮಗಾರಿಗಳ ಪ್ರಗತಿಯ ಬಗ್ಗೆ ನಾಗರಿಕರಿಗೆ ಅರಿವಿರುವುದಿಲ್ಲ. ಗ್ರಾಮ-ಸುವಿಧಾ ಗ್ರಾಮ ಮಟ್ಟದ ಆಸ್ತಿಗಳಿಗಾಗಿ \'ಡಿಜಿಟಲ್ ಪ್ರಗತಿ\'ಯನ್ನು ದೃಶ್ಯೀಕರಿಸುವ ಗುರಿಯನ್ನು ಹೊಂದಿದೆ.</string>
    <string name="vision_description">ಗ್ರಾಮ-ಸುವಿಧಾ ಪಾರದರ್ಶಕತೆ-ಕೇಂದ್ರಿತ ಯೋಜನಾ ಟ್ರ್ಯಾಕರ್ ಆಗಿದೆ. ಇದು ಪ್ರತಿಯೊಬ್ಬ ನಾಗರಿಕನಿಗೂ ಅಭಿವೃದ್ಧಿ ಎಲ್ಲಿದೆ ಎಂಬುದನ್ನು ನಿಖರವಾಗಿ ತಿಳಿಯಲು \'ಡಿಜಿಟಲ್ ಸೂಚನಾ ಫಲಕ\'ವನ್ನು ರಚಿಸುತ್ತದೆ.</string>
